<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone through Android's own backup or phone-to-phone copy: health data,
     the student card photos and the encryption keys stay here. The account's copy (which the
     student controls in the app) is how data moves to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
