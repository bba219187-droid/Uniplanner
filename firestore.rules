rules_version = '2';

// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // A profile is read by its id only (friends, group members). Nobody can list every student:
    // friend codes are looked up in friendCodes instead.
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && me() == uid;
      // The friend code never changes, so nobody can take over someone else's code.
      allow update: if signedIn() && me() == uid
        && (!('friendCode' in resource.data) || request.resource.data.friendCode == resource.data.friendCode);
      // Deleting the account removes the profile.
      allow delete: if signedIn() && me() == uid;

      // The student's own planner copy; nobody else can read it.
      match /private/{doc} {
        allow read, write: if signedIn() && me() == uid;
      }
    }

    // Friend code -> account, so a code finds one student without listing them all.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && get(/databases/$(database)/documents/users/$(me())).data.friendCode == code;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Invite code -> group, so a code finds one group without listing them all.
    match /groupInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['groupId'])
        && me() in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.members
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.inviteCode == code;
      allow update: if false;
      allow delete: if signedIn()
        && (!exists(/databases/$(database)/documents/groups/$(resource.data.groupId))
          || get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerId == me());
    }

    match /friendships/{id} {
      allow read: if signedIn() && (resource == null || me() in resource.data.members);
      allow create: if signedIn()
        && request.resource.data.requestedBy == me()
        && me() in request.resource.data.members
        && request.resource.data.members.size() == 2
        && request.resource.data.status == 'pending';
      // Only the person who received the request can accept it.
      allow update: if signedIn() && me() in resource.data.members && (
        (me() != resource.data.requestedBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'accepted')
        // Either friend keeps the newest message on the chat, for the chat list.
        || (resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastAt', 'lastBy', 'lastName']))
      );
      allow delete: if signedIn() && me() in resource.data.members;

      function isFriendChat() {
        let f = get(/databases/$(database)/documents/friendships/$(id)).data;
        return me() in f.members && f.status == 'accepted';
      }

      match /messages/{messageId} {
        allow read: if signedIn() && isFriendChat();
        allow create: if signedIn() && isFriendChat() && request.resource.data.authorId == me();
        allow delete: if signedIn() && resource.data.authorId == me();
        allow update: if false;
      }
    }

    // Where students are, only for those who said yes in the app.
    function isAdmin() { return exists(/databases/$(database)/documents/admins/$(me())); }
    function isFriend(other) {
      let a = /databases/$(database)/documents/friendships/$(me() + '_' + other);
      let b = /databases/$(database)/documents/friendships/$(other + '_' + me());
      return (exists(a) && get(a).data.status == 'accepted') || (exists(b) && get(b).data.status == 'accepted');
    }

    // Admins are added by hand in the Firebase console; nobody can add themselves.
    match /admins/{uid} {
      allow read: if signedIn() && me() == uid;
      allow write: if false;
    }

    // City and country, for the admin's overview.
    match /stats/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow write: if signedIn() && me() == uid;
    }

    // A location shared with friends.
    match /friendLocations/{uid} {
      allow read: if signedIn() && (me() == uid || isFriend(uid));
      allow write: if signedIn() && me() == uid;
    }

    match /groups/{groupId} {
      // Only members see the group (name, members, newest message). Others join with the invite code.
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        && request.resource.data.members == [me()];
      // Owners edit the group; anyone else may only add or remove themselves.
      allow update: if signedIn() && (
        resource.data.ownerId == me()
        // Members keep the newest message on the group, for the chat list.
        || (me() in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastAt', 'lastBy', 'lastName']))
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && (
            (request.resource.data.members.size() == resource.data.members.size() + 1
              && request.resource.data.members.hasAll(resource.data.members)
              && me() in request.resource.data.members)
            || (request.resource.data.members.size() == resource.data.members.size() - 1
              && resource.data.members.hasAll(request.resource.data.members)
              && !(me() in request.resource.data.members))
          )
        )
      );
      allow delete: if signedIn() && resource.data.ownerId == me();

      function isMember() {
        return me() in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }

      match /posts/{postId} {
        allow read: if signedIn() && isMember();
        allow create: if signedIn() && isMember() && request.resource.data.authorId == me();
        allow delete: if signedIn() && resource.data.authorId == me();
        allow update: if false;
      }
    }
  }
}
