rules_version = '2';

// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // Profiles are visible to signed-in students (needed to find friends by code).
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid;
      allow delete: if false;
    }

    match /friendships/{id} {
      allow read: if signedIn() && (resource == null || me() in resource.data.members);
      allow create: if signedIn()
        && request.resource.data.requestedBy == me()
        && me() in request.resource.data.members
        && request.resource.data.members.size() == 2
        && request.resource.data.status == 'pending';
      // Only the person who received the request can accept it.
      allow update: if signedIn()
        && me() in resource.data.members
        && me() != resource.data.requestedBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && me() in resource.data.members;
    }

    match /groups/{groupId} {
      // Readable by signed-in students so an invite code can be looked up.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        && request.resource.data.members == [me()];
      // Owners edit the group; anyone else may only add or remove themselves.
      allow update: if signedIn() && (
        resource.data.ownerId == me()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && (
            (request.resource.data.members.size() == resource.data.members.size() + 1
              && request.resource.data.members.hasAll(resource.data.members)
              && me() in request.resource.data.members)
            || (request.resource.data.members.size() == resource.data.members.size() - 1
              && resource.data.members.hasAll(request.resource.data.members)
              && !(me() in request.resource.data.members))
          )
        )
      );
      allow delete: if signedIn() && resource.data.ownerId == me();

      function isMember() {
        return me() in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }

      match /posts/{postId} {
        allow read: if signedIn() && isMember();
        allow create: if signedIn() && isMember() && request.resource.data.authorId == me();
        allow delete: if signedIn() && resource.data.authorId == me();
        allow update: if false;
      }
    }
  }
}
